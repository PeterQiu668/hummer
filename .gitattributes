# 证据文件按字节做 SHA-256（scripts/verify-m5g-evidence.mjs、verify-receipt.mjs）。
# Windows 上 core.autocrlf=true 会在检出时把 LF 改成 CRLF，哈希随之改变，校验必败。
# -text：对这些文件不做任何换行转换，检出即原始字节。
spikes/** -text

# 生成的配置由 packages/config/scripts/generate.mjs --check 逐字节比对，生成器写 LF。
apps/desktop/src/config/*.json text eol=lf
src/features/engines/engine-profiles.json text eol=lf
src/features/sessions/runtime/runtime-pricing.json text eol=lf
src/features/tools/tool-definitions.json text eol=lf
