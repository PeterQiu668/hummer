{
  "name": "@hummer/desktop",
  "private": true,
  "version": "0.5.0-internal.1",
  "description": "HUMMER trusted enterprise agent desktop",
  "author": "HUMMER",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "node ../../packages/config/scripts/generate.mjs",
    "build": "tsc -b",
    "start": "electron dist/main.js",
    "package:dir": "electron-builder --dir",
    "package:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "jszip": "3.10.1"
  },
  "build": {
    "appId": "com.hummer.desktop",
    "productName": "HUMMER",
    "directories": {
      "output": "../../release/m5e"
    },
    "electronDist": "../../node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "!dist/win-unpacked*/**/*"
    ],
    "extraResources": [
      {
        "from": "../../dist",
        "to": "renderer"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "HUMMER-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289"
  }
}
