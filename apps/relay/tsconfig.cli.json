{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "../..",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@hummer/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../packages/contracts/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "../../packages/contracts/src/**/*.test.ts"
  ]
}
